{
  "manifest_version": 3,
  "name": "Derruba Muro",
  "version": "1.3.0",
  "description": "Remove sobreposições de paywall, avisos de adblock e banners de anúncios em sites de notícias, restaura textos truncados, libera a rolagem e abre cópias arquivadas.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Derruba Muro"
  },
  "commands": {
    "run-unblock": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Remover bloqueio na página atual"
    },
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Alternar Modo Leitura"
    }
  }
}
